#!/bin/sh
# Rejects files over a token budget, estimated as bytes / 4, so no file
# outgrows what a coding agent can read whole.
#
# Usage: check-token-limit [--max-tokens=N] [--guide=PATH] FILE...
#   --max-tokens  budget per file (default 5000)
#   --guide       where the repo explains how to split its files
set -eu

max_tokens=5000
guide=""

while [ $# -gt 0 ]; do
  case "$1" in
    --max-tokens=*) max_tokens=${1#*=} ;;
    --guide=*) guide=${1#*=} ;;
    --) shift; break ;;
    *) break ;;
  esac
  shift
done

case "$max_tokens" in
  '' | *[!0-9]*) echo "check-token-limit: --max-tokens must be a whole number" >&2; exit 2 ;;
esac

max_bytes=$((max_tokens * 4))
failed=""
nl='
'

# Measure the staged copy, so unstaged edits neither pass nor fail a commit.
# One git call sizes every file; a call per file took seconds on a big repo.
# It answers one line per path, in order. ":0:" names the staged copy, so a
# path like "1:foo" isn't read as a stage number. Paths holding a newline are left
# out, as they would span two lines. The "(" before each case pattern lets
# macOS's bash 3.2 parse a case inside $(...).
sizes=$(
  for file in "$@"; do
    case "$file" in (*"$nl"*) ;; (*) printf ':0:%s\n' "$file" ;; esac
  done | git cat-file --batch-check='%(objectsize)' --buffer 2>/dev/null
) || sizes=""

for file in "$@"; do
  bytes=""
  case "$file" in (*"$nl"*) ;; (*) IFS= read -r bytes <&3 || bytes="" ;; esac
  case "$bytes" in
    # Not sized above, or not in the index ("<path> missing"): ask git for
    # this file alone, then fall back to its size on disk.
    '' | *[!0-9]*) bytes=$(git cat-file -s ":0:$file" 2>/dev/null || wc -c <"$file") ;;
  esac
  bytes=$((bytes + 0))
  if [ "$bytes" -gt "$max_bytes" ]; then
    failed="$failed  $file: ~$((bytes / 4)) tokens ($bytes bytes)
"
  fi
done 3<<EOF
$sizes
EOF

[ -z "$failed" ] && exit 0

cat >&2 <<EOF
Files over the $max_tokens-token limit (tokens = bytes / 4, max $max_bytes bytes):
$failed
Split each file so every part stays under $max_tokens tokens:

  1. Find the seams: group the file's contents by responsibility
     (one class, component, hook, concern, or topic per group).
  2. Move each group into its own file next to the original, named
     after what it holds.
  3. Keep the original file as the entry point: it requires, imports,
     or links the new parts, so callers do not change.
  4. Move code as it is. Do not shorten names, delete comments, or
     minify to get under the limit.
  5. Run the repo's tests and lint, stage the new files, commit again.
EOF
if [ -n "$guide" ]; then
  echo "
How this repo splits each kind of file: $guide" >&2
fi
cat >&2 <<'EOF'

Only lockfiles, generated code, or files kept whole on purpose may be
excluded instead, in the hook's `exclude:` in .pre-commit-config.yaml.
EOF
exit 1
